{
  "name": "@weibaohui/dsh-continue",
  "version": "0.2.1",
  "description": "DeepSeek Harness plugin: auto-resume interrupted agent runs. 有序规则表驱动——按失败类型（限流/额度/鉴权/上下文超限/5xx/传输错误/崩溃孤儿）路由：继续续跑、换模型继续、压缩后继续（ctx.compaction）或停止并通知。",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "plugin",
    "auto-continue",
    "resume",
    "retry"
  ],
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/bundle.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "src",
    "client",
    "cordis.patch.yml"
  ],
  "scripts": {
    "check": "node --check src/index.js && node --check client/index.js",
    "test": "node --test test/*.test.mjs",
    "build:client": "node scripts/build-client.mjs",
    "prepublishOnly": "npm run build:client && npm run check && npm test"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {},
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weibaohui/dsh-continue.git"
  },
  "homepage": "https://github.com/weibaohui/dsh-continue#readme",
  "bugs": {
    "url": "https://github.com/weibaohui/dsh-continue/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
